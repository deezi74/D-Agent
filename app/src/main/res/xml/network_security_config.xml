<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP is allowed so local servers work: FreeLLMAPI, Ollama, the on-phone model server. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
