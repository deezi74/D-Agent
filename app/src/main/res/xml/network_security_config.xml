<?xml version="1.0" encoding="utf-8"?>
<!--
  Plain HTTP is allowed so D-Agent can reach servers on your own home network
  (LM Studio or Ollama on a PC, D-Agent PC on :8787, FreeLLMAPI in Termux).
  Cloud providers all use HTTPS anyway. On a shared or public Wi-Fi, prefer HTTPS
  (for example Tailscale HTTPS names), since plain HTTP can be read by others on it.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
